    "cards":  [
                  {
                      "dot":  "emerald",
                      "title":  "One LLM pass per item",
                      "items":  [
                                    "Only documents without a fact are sent",
                                    "Relevance, category, sentiment and a Thai summary come back in one answer",
                                    "Off-topic news (news, rss) is stored as irrelevant so it is never re-sent"
                                ]
                  },
                  {
                      "dot":  "violet",
                      "title":  "Accuracy loop",
                      "items":  [
                                    "The review queue is about one third dropped items, so both sides are measured",
                                    "Up to 6 checked mistakes become examples in the next prompt",
                                    "Re-classify old news skips anything a human already checked"
                                ]
                  }
              ]
