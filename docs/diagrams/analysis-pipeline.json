  "cards": [
    {
      "dot": "emerald",
      "title": "Main path",
      "items": [
        "One pipeline.run serves the app button and the daily scheduler",
        "Items already in documents are never sent to the LLM again",
        "Every number is computed in pandas before the LLM writes prose"
      ]
    },
    {
      "dot": "amber",
      "title": "LLM calls",
      "items": [
        "Classifier: one call per 10 headlines or 5 items with text",
        "Report writer: one call per run, retried once if Chinese text appears",
        "Change detection and market metrics use no LLM"
      ]
    },
    {
      "dot": "rose",
      "title": "Also in the report",
      "items": [
        "Changes since the last run open the report and the overview",
        "Sector ranks and abnormal price moves when SET financials are on",
        "Reviews (table R) and internal metrics (table I) stay out of news counts",
        "Raw source JSON is written to data/raw for auditing"
