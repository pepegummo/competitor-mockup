LLM_API_KEY=

# ไม่บังคับ: ส่งแจ้งเตือนเมื่อชุดติดตามมีเรื่องสำคัญ (Discord / Slack / Microsoft Teams / Google Chat webhook)
ALERT_WEBHOOK_URL=

# ไม่บังคับ: ค้นด้วยความหมายในแท็บถามข้อมูล · local = รันโมเดลในเครื่อง (ค่าเริ่ม) · api = /v1/embeddings ของ endpoint LLM
EMBED_BACKEND=local
# เว้นว่าง = intfloat/multilingual-e5-small (local) หรือโมเดลเดียวกับ LLM (api)
EMBED_MODEL=

# ไม่บังคับ: service อ่าน PDF (container ocr) เช่น http://localhost:8000 หรือ http://ocr:8000 ใน docker compose
# เว้นว่าง = อ่าน PDF ในแอปเอง หน้าสแกนจะ OCR ได้เฉพาะเมื่อเครื่องนี้ลง Tesseract ไว้
OCR_URL=

# ฐานข้อมูล · เว้นว่าง = SQLite ไฟล์ data/app.db (รันบนเครื่อง/เดโม)
#   RDS (Huawei):         postgresql://app:<รหัส>@<IP ภายในของ RDS>:5432/competitor
#   container db ใน compose (docker compose --profile localdb up -d):  postgresql://app:<POSTGRES_PASSWORD>@db:5432/competitor
# รหัสผ่านใช้เฉพาะตัวอักษรและตัวเลข (อักขระพิเศษต้อง encode ใน URL) · ย้ายข้อมูลเดิมจาก SQLite: ดู DEPLOY.md ขั้นที่ 7
DATABASE_URL=

# ---------- docker compose เท่านั้น (รันบนเครื่องด้วย streamlit ไม่ต้องใส่) ----------
# container เสริมที่จะเปิด (คั่นด้วย ,): ocr = อ่าน PDF สแกน (ใส่ OCR_URL=http://ocr:8000 ด้วย) · localdb = container db (PostgreSQL)
#   ใช้ RDS: ocr · ใช้ container db: localdb,ocr · เว้นว่าง = ไม่เปิดเพิ่ม · ตั้งแล้วไม่ต้องใส่ --profile ในทุกคำสั่ง
COMPOSE_PROFILES=
# รหัสของ container db (profile localdb) ต้องตรงกับใน DATABASE_URL · ใช้ RDS หรือ SQLite เว้นว่างได้
POSTGRES_PASSWORD=
# เวลารันทุกชุดติดตามอัตโนมัติทุกวัน (เวลาไทย) · เว้นว่าง = ไม่รันอัตโนมัติ
MONITOR_AT=07:00
# ชื่อโดเมนของเว็บ เช่น 1-2-3-4.sslip.io (Caddy ขอ HTTPS ให้เอง) · เว้นว่าง = http://localhost
SITE_ADDRESS=
# บนเครื่องที่พอร์ต 80/443 ถูกใช้อยู่ ใส่ 8080 / 8443 แล้วเปิด http://localhost:8080 · บน ECS เว้นว่าง (80/443)
HTTP_PORT=
HTTPS_PORT=
# รหัสเข้าเว็บ (ไม่บังคับ) · BASIC_AUTH_HASH เว้นว่าง = ไม่มีรหัส ทุกคนที่มีลิงก์เข้าและกดวิเคราะห์ได้ (ใช้ LLM key)
# เปิดรหัส: docker run --rm caddy:2 caddy hash-password --plaintext 'รหัสผ่าน' แล้วใส่ผลในเครื่องหมาย ' '
#           (มีตัว $ ไม่ใส่ ' ' compose จะตีความเป็นตัวแปร) แล้ว docker compose up -d
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=
# image ที่ใช้ · เว้นว่าง: ชุดที่ดึงจาก image ใช้ quix07/competitor-app และ competitor-ocr รุ่นเดียวกับชุด · docker-compose.yml ในโค้ดหลัก build เอง
# เปลี่ยนรุ่น เช่น APP_IMAGE=quix07/competitor-app:0.3  OCR_IMAGE=quix07/competitor-ocr:0.3
APP_IMAGE=
OCR_IMAGE=
